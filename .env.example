# Copy this file to `.env` and fill in real values. Never commit `.env`.

# DeepSeek API Key (used by the gated DeepSeek integration test)
AI_TERMINAL_DEEPSEEK_API_KEY=

# Real SSH/SFTP integration test target (used by the `test:ssh`, `test:sftp`,
# and `test:agent:ssh` scripts). Leave empty to skip those tests.
AI_TERMINAL_SSH_TEST_HOST=
AI_TERMINAL_SSH_TEST_PORT=22
AI_TERMINAL_SSH_TEST_USER=
AI_TERMINAL_SSH_TEST_PASSWORD=
