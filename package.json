{
  "name": "glass-terminal",
  "version": "0.1.0-beta.3",
  "private": true,
  "description": "Windows-first visible AI agent terminal for local and SSH workflows",
  "license": "MIT",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:ssh": "vitest run src/main/terminal/ssh-integration.test.ts",
    "test:sftp": "vitest run src/main/sftp/sftp-integration.test.ts",
    "test:agent:ssh": "vitest run src/main/agent/agent-workspace-ssh.integration.test.ts",
    "build:renderer": "vite build",
    "build:electron": "tsup",
    "build": "npm run typecheck && npm test && npm run build:renderer && npm run build:electron",
    "package": "electron-builder --dir",
    "postpackage": "npm rebuild node-pty",
    "package:win": "electron-builder --dir --win",
    "smoke": "cross-env AI_TERMINAL_SMOKE_TEST=1 electron .",
    "smoke:ssh": "cross-env AI_TERMINAL_SSH_SMOKE_TEST=1 electron .",
    "smoke:agent": "cross-env AI_TERMINAL_AGENT_SMOKE_TEST=1 electron .",
    "smoke:agent:ssh": "cross-env AI_TERMINAL_AGENT_SSH_SMOKE_TEST=1 electron .",
    "start": "electron ."
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "dependencies": {
    "@langchain/core": "^1.2.8",
    "@langchain/openai": "^1.5.8",
    "adm-zip": "^0.5.18",
    "iconv-lite": "^0.7.3",
    "node-pty": "^1.1.0",
    "ssh2": "^1.17.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/ssh2": "^1.15.5",
    "@vitejs/plugin-react": "^6.0.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "jsdom": "^27.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.0",
    "wait-on": "^9.0.3"
  },
  "allowScripts": {
    "esbuild@0.27.7": true,
    "node-pty@1.1.0": true,
    "ssh2@1.17.0": true
  }
}
